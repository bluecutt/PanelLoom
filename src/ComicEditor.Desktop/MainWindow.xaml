<Window x:Class="ComicEditor.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="漫画组装器 · 原生预览版" Width="1440" Height="960" MinWidth="1040" MinHeight="700" Background="#F7F8FA" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D9DFE5"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="BorderBrush" Value="#CAD2DB"/></Style>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE2E8" BorderThickness="0,0,0,1" Padding="14,10">
   <WrapPanel>
    <TextBlock Text="漫画组装器" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="0,0,24,0"/>
    <Button Content="打开工程" Click="OpenClick"/><Button Content="保存" Click="SaveClick"/><Button Content="撤销" Click="UndoClick"/><Button Content="重做" Click="RedoClick"/><Button Content="高清导出 PNG" Click="ExportClick"/>
    <Menu Background="Transparent" VerticalAlignment="Center" Margin="12,0"><MenuItem Header="项目"><MenuItem Header="另存为" Click="SaveAsClick"/><MenuItem Header="页面设置" Click="PageClick"/><MenuItem Header="恢复快照" Click="RecoveryClick"/></MenuItem><MenuItem Header="导入"><MenuItem Header="完整分镜素材" Click="ImportPanelClick"/><MenuItem Header="独立气泡素材" Click="ImportBalloonClick"/></MenuItem></Menu>
    <CheckBox x:Name="AgentWrite" Content="允许 Agent 修改本次会话" VerticalAlignment="Center" Margin="18,0,0,0" Checked="AgentWriteChanged" Unchecked="AgentWriteChanged"/>
   </WrapPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DCE2E8" BorderThickness="0,1,0,0" Padding="14,8"><TextBlock x:Name="StatusText" Text="就绪"/></Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="170"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="330" MinWidth="270"/></Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0" Background="White" Margin="0,0,0,0">
    <StackPanel DockPanel.Dock="Top" Margin="14,16,14,10"><TextBlock Text="对象" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="分镜与气泡独立排序" Foreground="#778391" Margin="0,6,0,0"/></StackPanel>
    <TabControl x:Name="ObjectTabs" SelectionChanged="ObjectTabChanged" BorderThickness="0"><TabItem Header="分镜"><ListBox x:Name="PanelsList" SelectionChanged="PanelSelected" DisplayMemberPath="Display" BorderThickness="0" Padding="8"/></TabItem><TabItem Header="气泡"><ListBox x:Name="BalloonsList" SelectionChanged="BalloonSelected" DisplayMemberPath="Display" BorderThickness="0" Padding="8"/></TabItem></TabControl>
   </DockPanel>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E3E7EB"/>
   <DockPanel Grid.Column="2" Background="#CFD5DC">
    <Border DockPanel.Dock="Top" Padding="12,6" Background="#E9EDF1"><WrapPanel><TextBlock Text="画布操作" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="ModeBox" Width="155" SelectionChanged="ModeChanged" DisplayMemberPath="Label" SelectedValuePath="Value"/><Button Content="适合窗口" Click="FitClick"/><CheckBox x:Name="GroupMoveBox" Content="拖动同组气泡" Checked="GroupMoveChanged" Unchecked="GroupMoveChanged" VerticalAlignment="Center" Margin="10,0"/><TextBlock Text="滚轮调图片/气泡 · Ctrl＋滚轮缩放整页 · 中键平移" Foreground="#637282" VerticalAlignment="Center" Margin="10,0,0,0"/></WrapPanel></Border>
    <Border x:Name="ContextToolbar" DockPanel.Dock="Top" Background="White" Padding="8,4" BorderBrush="#DAE1E8" BorderThickness="0,0,0,1">
     <WrapPanel>
      <StackPanel x:Name="PanelToolButtons" Orientation="Horizontal"><Button Content="图片" Tag="Image" Click="ToolButtonClick"/><Button Content="框线" Tag="FrameOnly" Click="ToolButtonClick"/><Button Content="顶点" Tag="Vertex" Click="ToolButtonClick"/><Button Content="选边" Tag="Edge" Click="ToolButtonClick"/><Button Content="吸附选中边" Click="SnapSelectedClick" ToolTip="蓝色为选中边，橙色为候选；仅移动当前分镜。自动吸附开关在页面设置中。"/></StackPanel>
      <Button Content="上移一层" Click="LayerUpClick"/><Button Content="下移一层" Click="LayerDownClick"/><Button x:Name="LockButton" Content="锁定" Click="LockClick"/><Button Content="替换素材" Click="ReplaceSelectedClick"/>
      <StackPanel x:Name="BalloonToolButtons" Orientation="Horizontal"><Button x:Name="ClipPickButton" Content="点选范围" Click="ClipPickClick"/><Button Content="整页自由" Click="FreeClipClick"/><Button Content="前后遮挡" Click="OcclusionMenuClick"/><Button Content="复制" Click="CopyBalloonClick"/></StackPanel>
      <TextBlock x:Name="SelectionHint" VerticalAlignment="Center" Foreground="#637282" Margin="10,0"/>
     </WrapPanel>
    </Border>
    <Border x:Name="CanvasHost" ClipToBounds="True" Margin="12"/>
   </DockPanel>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#E3E7EB"/>
   <Border x:Name="InspectorHost" Grid.Column="4" Background="White"/>
  </Grid>
 </DockPanel>
</Window>
